<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.NexoPay.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.NexoPay.ActionButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">88dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">26dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/nexo_card</item>
        <item name="android:textColor">@color/nexo_primary_dark</item>
        <item name="strokeColor">@color/nexo_surface_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:elevation">1dp</item>
    </style>

    <style name="ThemeOverlay.NexoPay.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.NexoPay.BottomSheet</item>
    </style>

    <style name="Widget.NexoPay.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.NexoPay.Sheet</item>
        <item name="backgroundTint">@color/nexo_card</item>
    </style>

    <style name="ShapeAppearanceOverlay.NexoPay.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ThemeOverlay.NexoPay.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/nexo_card</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.NexoPay.Dialog</item>
    </style>

    <style name="ShapeAppearance.NexoPay.Dialog" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Widget.NexoPay.SheetHandle" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">5dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginBottom">24dp</item>
        <item name="android:background">@drawable/bg_sheet_handle</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Widget.NexoPay.AvailableBalance" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/bg_soft_panel</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/nexo_primary_dark</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.NexoPay.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <style name="TextAppearance.NexoPay.Balance" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

</resources>
